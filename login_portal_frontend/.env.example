# Frontend environment variables for login_portal_frontend
# Do NOT commit real secrets. Copy to .env and fill in values.

# Base URL of your backend API (used for auth endpoints)
REACT_APP_API_BASE_URL=http://localhost:4000

# Site URL used by backend for OAuth redirects (if needed by your backend)
# The deployment system maps this to the final URL. Keep it consistent.
REACT_APP_SITE_URL=http://localhost:3000

# OAuth client IDs (frontend reference; actual OAuth is typically handled by backend)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_GITHUB_CLIENT_ID=your-github-client-id
REACT_APP_FACEBOOK_APP_ID=your-facebook-app-id
